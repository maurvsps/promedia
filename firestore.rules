rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir a los usuarios leer y escribir solo sus propios documentos en la colección "users"
    // Permitir al administrador (mvegas0403@gmail.com) leer las estadísticas globales
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'mvegas0403@gmail.com');
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Permitir a cualquier usuario enviar sugerencias / feedback, y al administrador leerlas
    match /suggestions/{suggestionId} {
      allow create: if true;
      allow read, delete: if request.auth != null && request.auth.token.email == 'mvegas0403@gmail.com';
      allow update: if false;
    }
  }
}
